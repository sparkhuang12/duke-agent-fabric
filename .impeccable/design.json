  "narrative": {
    "northStar": "青年杂志编辑部",
    "overview": "写作台以粉色标题栏搭配编辑桌面摄影，产品首页以荧光黄绿配人物封面摄影。读者进入编辑区后，稿纸、材料和复核意见占据主要阅读空间。",
    "keyCharacteristics": [
      "大幅摄影与中文粗黑标题并置，封面文字落在纯色色块上。",
      "荧光黄绿标出当前角色，天蓝栏保留交付内容与复核边界。",
      "摄影和标题字体随应用加载，内网也能看到完整的版面。"
    ],
    "rules": [
      {
        "name": "The Manuscript Rule",
        "body": "正文保留原始段落与换行，桌面阅读行宽上限为 70ch。",
        "section": "typography"
      }
    ],
    "dos": [
      "Do 让摄影的主体与封面文字各自拥有连续的可读区域。",
      "Do 保留稿件状态文字以及按钮的可见焦点。"
    ],
    "donts": [
      "Don't 把封面摄影延伸到草稿与复核正文背后。",
      "Don't 拆开产品标题中的短语，留下单个汉字占一行。"
    ]
  }

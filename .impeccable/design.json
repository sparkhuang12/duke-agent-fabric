      "html": "<div class=\"ds-metrics\"><div><strong>6</strong>办公智能体</div><div><strong>5</strong>架构层</div><div><strong>3</strong>建设阶段</div><div><strong>800</strong>万元预算</div></div>",
      "css": ".ds-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:3px;color:var(--ink,#1c191e);font:.84rem var(--ui-font,sans-serif)}.ds-metrics div{padding:.9rem clamp(14px,2.3vw,36px) 1rem;background:var(--lime,#e8fa53)}.ds-metrics div:nth-child(2){background:var(--pink,#ffaaca)}.ds-metrics div:nth-child(3){background:var(--sky,#c1e8ff)}.ds-metrics div:nth-child(4){background:var(--ink,#1c191e);color:var(--surface,#fffefa)}.ds-metrics strong{display:block;font:800 clamp(2.15rem,4vw,3.9rem)/1.07 var(--display-font,sans-serif);letter-spacing:-.04em}@media(max-width:720px){.ds-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}}"
    }

  "narrative": {
    "northStar": "独立出版工作室",
    "overview": "铅笔、圈画笔迹和校样拼贴把写作台与产品介绍连在一起。进入稿纸后，材料、正文和复核意见占据主要阅读空间。",
    "keyCharacteristics": [
      "淡紫封面、钴蓝油墨、奶油色稿纸。",
      "在作者身边留一本可随工作角色切换的手册。",
      "使用本地字体和图像，在内网也能看到完整的版面。"
    ],
    "rules": [
      {
        "name": "The Manuscript Rule",
        "body": "正文保留原始段落与换行，桌面阅读行宽上限为 70ch。",
        "section": "typography"
      }
    ],
    "dos": [
      "Do 用两段完整短语安排产品标题在手机上的换行。",
      "Do 保留稿件状态文字以及按钮的可见焦点。"
    ],
    "donts": [
      "Don't 把封面拼贴延伸到草稿与复核正文背后。",
      "Don't 仅靠状态颜色区分当前角色或待复核稿件。"
    ]
  }

      "html": "<section class=\"ds-handbook\"><h2>角色手册<i aria-hidden=\"true\"></i></h2><dl><dt>交付内容</dt><dd>公文草稿、依据清单、待核事项</dd></dl></section>",
      "css": ".ds-handbook{position:relative;padding:1.25rem 1.45rem 1.45rem;background:var(--sky,#c1e8ff);color:#192d39}.ds-handbook h2{display:flex;justify-content:space-between;margin:0;padding-bottom:.8rem;border-bottom:1px solid #829fb0;font:800 1.2rem/1.4 var(--display-font,sans-serif)}.ds-handbook i{width:1.35rem;height:1.85rem;margin-top:-1.25rem;background:var(--blue,#302bb9);clip-path:polygon(0 0,100% 0,100% 100%,50% 75%,0 100%)}.ds-handbook dl,.ds-handbook dd{margin:0}.ds-handbook dt{margin:.9rem 0 .2rem;color:#3f5968;font:700 .77rem var(--ui-font,sans-serif)}.ds-handbook dd{font:.88rem/1.75 var(--ui-font,sans-serif)}"

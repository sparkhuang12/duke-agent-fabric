      "css": ".ds-role{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;padding:.45rem .65rem;min-height:44px;border:0;border-bottom:2px solid var(--ink,#1c191e);border-radius:0;background:var(--lime,#e8fa53);color:var(--ink,#1c191e);font:700 .9rem var(--ui-font,sans-serif);cursor:pointer}.ds-role:focus-visible{outline:3px solid var(--blue,#302bb9);outline-offset:3px}"

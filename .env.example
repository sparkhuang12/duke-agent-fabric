# Local development defaults. Production values should come from a secret manager.
DUKE_ENVIRONMENT=development
DUKE_HOST=127.0.0.1
DUKE_PORT=9090
DUKE_LOG_LEVEL=INFO
DUKE_DATABASE_URL=sqlite:///data/harness.db
DUKE_REDIS_URL=
DUKE_STORAGE_ALLOWED_HOSTS=mysql.internal,redis.internal

# Single-host Compose secrets: use URL-safe random values.
MYSQL_PASSWORD=replace-with-url-safe-random-value
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-value
REDIS_PASSWORD=replace-with-url-safe-random-value

# Seven-day short-term context; one-year explicitly promoted long-term memory.
DUKE_SHORT_TERM_RETENTION_DAYS=7
DUKE_LONG_TERM_RETENTION_DAYS=365
DUKE_CONTEXT_RECENT_MESSAGES=12
DUKE_CONTEXT_MAX_CHARS=24000
DUKE_CONTEXT_SUMMARY_CHARS=4000

# Self-hosted OpenAI-compatible gateway only. Recommended: vLLM directly or
# LiteLLM configured exclusively with on-premises upstreams.
DUKE_MODEL_API_BASE=http://llm-gateway.internal:4000/v1
DUKE_MODEL_API_KEY=replace-me
DUKE_MODEL_NAME=approved-on-prem-model
DUKE_MODEL_FALLBACKS=approved-on-prem-fallback
DUKE_MODEL_ALLOWED_HOSTS=llm-gateway.internal
DUKE_MODEL_TIMEOUT_SECONDS=45
DUKE_MODEL_MAX_RETRIES=2

# OPA. Development may use the embedded fallback; production may not.
DUKE_OPA_URL=http://127.0.0.1:8181
DUKE_OPA_ALLOWED_HOSTS=opa.internal
DUKE_OPA_FAILURE_MODE=closed
DUKE_OPA_EMBEDDED_DEVELOPMENT_FALLBACK=true

# Development can use headers. Production requires OIDC; Keycloak is the
# documented default and these claims are configured with Protocol Mappers.
DUKE_AUTH_MODE=development_headers
DUKE_OIDC_ISSUER=https://sso.internal.example/realms/duke
DUKE_OIDC_AUDIENCE=duke-agent-fabric
DUKE_OIDC_JWKS_URL=https://sso.internal.example/realms/duke/protocol/openid-connect/certs
DUKE_OIDC_ALLOWED_HOSTS=sso.internal.example
DUKE_OIDC_TENANT_CLAIM=tenant_id
DUKE_OIDC_DEPARTMENT_CLAIM=department
DUKE_OIDC_ROLES_CLAIM=realm_access.roles
DUKE_OIDC_CLEARANCE_CLAIM=clearance

# Execution budgets
DUKE_MAX_GRAPH_STEPS=12
DUKE_MAX_TOOL_CALLS=6
DUKE_MAX_RUN_SECONDS=180
DUKE_EXECUTION_WORKERS=8
DUKE_MAX_PENDING_RUNS=32
DUKE_CIRCUIT_BREAKER_THRESHOLD=5
DUKE_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Data residency: external tracing is disabled by the production guard.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
